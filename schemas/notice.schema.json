{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ahik/schemas/notice.schema.json",
  "title": "Notice",
  "type": "object",
  "required": ["notice_id", "application_id", "notice_type", "subject", "body", "created_at", "issuing_party"],
  "properties": {
    "notice_id": { "type": "string" },
    "application_id": { "type": "string" },
    "notice_type": {
      "type": "string",
      "enum": ["appointment", "document_deadline", "eligibility_outcome", "appeal_outcome", "lease_offer", "general"]
    },
    "subject": { "type": "string" },
    "body": { "type": "string" },
    "channel": {
      "type": "string",
      "enum": ["mail", "email", "sms", "portal"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "sent_at": { "type": "string", "format": "date-time" },
    "respond_by": { "type": "string", "format": "date-time" },
    "issuing_party": { "type": "string" },
    "related_status_event_id": { "type": "string" },
    "human_review_required": { "type": "boolean", "default": true }
  }
}
