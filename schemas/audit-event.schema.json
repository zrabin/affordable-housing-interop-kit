{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ahik/schemas/audit-event.schema.json",
  "title": "Audit Event",
  "type": "object",
  "required": ["audit_id", "occurred_at", "actor", "action", "subject", "purpose", "source_system", "privacy_classification"],
  "properties": {
    "audit_id": { "type": "string" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "actor": {
      "type": "object",
      "required": ["actor_type", "actor_id"],
      "properties": {
        "actor_type": { "enum": ["human", "system", "agent"] },
        "actor_id": { "type": "string" }
      }
    },
    "action": { "type": "string" },
    "subject": { "type": "string" },
    "purpose": { "type": "string" },
    "source_system": { "type": "string" },
    "privacy_classification": { "enum": ["public", "internal", "sensitive", "restricted"] },
    "human_approval_required": { "type": "boolean" },
    "human_approval_id": { "type": "string" }
  }
}

